rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /partidos/{partidoId} {
      allow read: if true;
      allow write: if false; // Solo el Admin SDK (scripts) puede escribir
    }
    match /predicciones/{predId} {
      allow read: if true;
      allow create, update: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && isMatchOpen(request.resource.data.matchId);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    function isMatchOpen(matchId) {
      let partido = get(/databases/$(database)/documents/partidos/$(matchId)).data;
      // Solo permite si la hora actual + 15 minutos es menor a la hora del partido
      return partido.utcDate != null && request.time + duration.value(15, 'm') < timestamp.value(partido.utcDate);
    }
  }
}